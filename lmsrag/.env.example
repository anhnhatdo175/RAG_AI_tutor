LLM_BACKEND=ollama
GENERATION_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_NEW_TOKENS=512
# For Transformers, set LLM_BACKEND=transformers and use a Hugging Face model ID.
# For Ollama, set LLM_BACKEND=ollama and configure OLLAMA_BASE_URL.
# For Groq, set LLM_BACKEND=groq and configure GROQ_API_KEY.
